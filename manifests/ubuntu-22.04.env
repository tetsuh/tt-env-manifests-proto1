# Manifest for Ubuntu 22.04 (proto1)

PKG_MANAGER="apt"

# Set USE_PPA=false to fall back to GitHub Releases direct download.
USE_PPA=true
REQUIRED_REPOS=(
    "ppa:tenstorrent/ppa"
)

VIRT_PKG_CMAKE="cmake"
VIRT_PKG_NINJA="ninja-build"
VIRT_PKG_ZLIB="zlib1g-dev"
VIRT_PKG_KMD="tt-kmd-dkms"

WORKAROUNDS=()
